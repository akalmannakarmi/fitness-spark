# MongoDB connection string
MONGO_URL=mongodb://mongodb:27017

# MongoDB database name
DATABASE_NAME=fastapi_auth

# Secret key used to sign JWTs. REQUIRED - application will not start without it.
# Use a long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Server bind address, port, and auto-reload (true/false)
HOST=0.0.0.0
PORT=8000
RELOAD=false
